# Copiar a .env y completar. NO commitear tokens reales.

# --- LLM: Groq primario con respaldo automático a Anthropic ante rate-limit ---
LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDER=anthropic
LLM_MAX_TOKENS=2048

# Groq (primario)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic (respaldo)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Recuperación densa: FAISS local por defecto ---
VECTOR_BACKEND=faiss

# --- Opcional: backend Pinecone (solo si VECTOR_BACKEND=pinecone) ---
# PINECONE_API_KEY=
# PINECONE_INDEX=

# --- Opcional: LLM local vía Ollama (si LLM_PROVIDER=ollama) ---
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:7b

# --- Logging ---
# LOG_LEVEL=WARNING
